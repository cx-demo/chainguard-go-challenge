FROM golang:1.18 AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /hello-server .

FROM scratch

COPY --from=builder /hello-server /hello-server

EXPOSE 8080
USER 65532:65532
ENTRYPOINT ["/hello-server"]
